# ===== MongoDB =====
MONGODB_URI=mongodb://localhost:27017/cyberlock

# ===== JWT =====
JWT_SECRET=cyberlock-super-secret-change-in-production
JWT_EXPIRE=24h

# ===== Server =====
PORT=5000
NODE_ENV=development

# ===== Client URL (for CORS) =====
CLIENT_URL=http://localhost:5173

# ===== AI Provider =====
# Supported: gemini | openai | anthropic
AI_PROVIDER=gemini
AI_API_KEY=your-ai-api-key-here
AI_MODEL=gemini-2.0-flash

# ===== Admin =====
ADMIN_EMAIL=admin@cyberlock.example
ADMIN_PASSWORD=CyberL0ck!Admin2024
